{
  "name": "nepteer-workspace",
  "private": true,
  "version": "0.3.0-alpha.0",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter @nepteer/desktop tauri dev",
    "build": "pnpm --filter @nepteer/desktop tauri build",
    "build:web": "pnpm --filter @nepteer/desktop build",
    "typecheck": "pnpm --filter @nepteer/desktop typecheck",
    "lint": "pnpm --filter @nepteer/desktop lint",
    "test": "pnpm --filter @nepteer/desktop test",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "rust:check": "cargo check --workspace --locked",
    "rust:test": "cargo test --workspace --locked",
    "rust:lint": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "bindings": "cargo test -p nepteer --lib telemetry::tests::export_bindings -- --ignored --exact",
    "licenses:js": "pnpm --recursive --include-workspace-root licenses list --json",
    "licenses:rust": "node scripts/rust-licenses.mjs",
    "bindings:check": "cargo test -p nepteer --lib telemetry::tests::bindings_are_current -- --exact"
  },
  "devDependencies": {
    "prettier": "^3.6.0"
  }
}
