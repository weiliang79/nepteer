{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Dashboard telemetry, fixed Quick Access operations and opt-in read-only controller diagnostics.",
  "windows": ["main"],
  "permissions": [
    "allow-get-telemetry",
    "allow-show-quick-access",
    "allow-hide-quick-access",
    "allow-toggle-quick-access",
    "allow-quick-access-status",
    "allow-neptune-list",
    "allow-neptune-rescan",
    "allow-neptune-start",
    "allow-neptune-stop",
    "allow-neptune-status",
    "allow-neptune-probe-start",
    "allow-neptune-probe-status",
    "allow-neptune-probe-abort",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
